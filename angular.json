{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ukmac-monitoring": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "maplibre-gl-{worker,shared}.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "vendor"
              },
              {
                "glob": "index.css",
                "input": "node_modules/@univerjs/preset-sheets-core/lib",
                "output": "vendor/univer/core"
              },
              {
                "glob": "index.css",
                "input": "node_modules/@univerjs/preset-sheets-filter/lib",
                "output": "vendor/univer/filter"
              },
              {
                "glob": "index.css",
                "input": "node_modules/@univerjs/preset-sheets-sort/lib",
                "output": "vendor/univer/sort"
              },
              {
                "glob": "index.css",
                "input": "node_modules/@univerjs/preset-sheets-conditional-formatting/lib",
                "output": "vendor/univer/conditional-formatting"
              },
              {
                "glob": "index.css",
                "input": "node_modules/@univerjs/preset-sheets-data-validation/lib",
                "output": "vendor/univer/data-validation"
              }
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/maplibre-gl/dist/maplibre-gl.css",
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "exceljs",
              "leaflet",
              "react",
              "react-dom",
              "react-dom/client",
              "react/jsx-runtime",
              "async-lock",
              "fast-diff",
              "ot-json1"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ukmac-monitoring:build:production"
            },
            "development": {
              "buildTarget": "ukmac-monitoring:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 1420
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
