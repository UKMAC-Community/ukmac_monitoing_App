{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UKMAC Monitoring",
  "version": "0.1.0",
  "identifier": "com.ukmac.monitoring",
  "build": {
    "frontendDist": "../dist/ukmac-monitoring/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run start -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "UKMAC Monitoring",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp":"default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob: https://server.arcgisonline.com; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self' https://server.arcgisonline.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Chili farm monitoring on this Mac",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}